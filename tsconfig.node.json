{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.diagnostics.config.ts",
    "tests/diagnostics/**/*.ts",
    "tests/e2e/**/*.ts",
    "playwright.visual.config.ts",
    "tests/visual/**/*.ts"
  ]
}
