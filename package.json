{
  "name": "papertrail-reader",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.test.json",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:pipeline": "node --test scripts/*.test.mjs",
    "test": "npm run test:pipeline && npm run test:unit",
    "check": "npm run lint && npm run format:check && npm test && npm run type-check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "epubjs": "0.3.93",
    "fflate": "0.8.2",
    "pdfjs-dist": "6.3.289",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
